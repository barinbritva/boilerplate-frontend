{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {"enabled": true, "clientKind": "git", "useIgnoreFile": true},
	"files": {"ignoreUnknown": true},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineEnding": "lf",
		"lineWidth": 120,
		"attributePosition": "auto",
		"bracketSameLine": false,
		"bracketSpacing": false,
		"expand": "auto",
		"useEditorconfig": true
	},
	"assist": {"enabled": false},
	"linter": {
		"rules": {
			"preset": "none"
		}
	},
	"javascript": {
		"formatter": {
			"jsxQuoteStyle": "double",
			"quoteProperties": "asNeeded",
			"trailingCommas": "all",
			"semicolons": "always",
			"arrowParentheses": "always",
			"bracketSameLine": false,
			"quoteStyle": "single",
			"attributePosition": "auto",
			"bracketSpacing": false
		}
	},
	"html": {
		"formatter": {
			"indentScriptAndStyle": false,
			"selfCloseVoidElements": "always"
		}
	},
	"overrides": [
		{
			"includes": ["src/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["..", "../**"],
										"message": "Use the #/ source alias instead of importing from a parent directory."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/core/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["..", "../**"],
										"message": "Use the #/ source alias instead of importing from a parent directory."
									},
									{
										"group": ["#/bootstrap/**", "#/modules/**", "#/ui/**"],
										"message": "Core must remain independent."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/modules/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["..", "../**"],
										"message": "Use the #/ source alias instead of importing from a parent directory."
									},
									{
										"group": ["#/bootstrap/**", "!#/bootstrap/router/RouteBuilder.js"],
										"message": "Modules must not depend on bootstrap. RouteBuilder is a temporary known exception."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/ui/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["..", "../**"],
										"message": "Use the #/ source alias instead of importing from a parent directory."
									},
									{
										"group": ["#/bootstrap/**", "#/modules/**", "#/core/**"],
										"message": "Global UI must remain presentation-only."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
