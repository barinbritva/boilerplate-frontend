{
	"name": "frontend",
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"engines": {
		"node": ">=24.16.0",
		"pnpm": ">=11.5.0"
	},
	"engineStrict": true,
	"volta": {
		"node": "24.20.0",
		"pnpm": "11.5.2"
	},
	"scripts": {
		"prepare": "lefthook install",
		"setup-app-env": "node --env-file-if-exists=.env tooling/setup-app-env.mts",
		"dev": "pnpm setup-app-env && vite --config tooling/vite.config.ts serve --mode development",
		"build:dev": "pnpm setup-app-env && vite --config tooling/vite.config.ts build --mode development",
		"build": "vite --config tooling/vite.config.ts build --mode production",
		"check-types:app": "tsc -p src/tsconfig.json --noEmit",
		"check-types:tooling": "tsc -p tooling/tsconfig.json --noEmit",
		"check-types": "pnpm check-types:app && pnpm check-types:tooling",
		"check-imports": "biome lint src",
		"check:lint-format": "biome check . && prettier --check \"**/*.{yml,yaml}\"",
		"fix:lint-format": "biome check --write . && prettier --write \"**/*.{yml,yaml}\"",
		"lint": "pnpm check:lint-format",
		"lint:fix": "pnpm fix:lint-format"
	},
	"dependencies": {
		"history": "5.3.0",
		"mobx": "7.0.0",
		"mobx-react-lite": "5.0.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"universal-router": "10.0.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@types/node": "26.1.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"lefthook": "2.1.9",
		"prettier": "3.9.6",
		"typescript": "7.0.2",
		"vite": "8.2.0",
		"vite-plugin-checker": "0.14.5"
	}
}
