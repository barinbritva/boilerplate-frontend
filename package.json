{
	"name": "frontend",
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"engines": {
		"node": ">=24.16.0",
		"pnpm": ">=11.5.0"
	},
	"engineStrict": true,
	"volta": {
		"node": "24.20.0",
		"pnpm": "11.5.2"
	},
	"scripts": {
		"prepare": "lefthook install",
		"setup-app-env": "node --env-file-if-exists=.env setup-app-env.mts",
		"dev": "pnpm setup-app-env && vite serve --mode development",
		"dev:storybook": "storybook dev -p 6006 -c storybook/.storybook",
		"build:dev": "pnpm setup-app-env && vite build --mode development",
		"build": "vite build --mode production",
		"build:storybook": "storybook build -c storybook/.storybook -o storybook/storybook-static",
		"check-types:app": "tsc -p src/tsconfig.json --noEmit",
		"check-types:tooling": "tsc -p tsconfig.json --noEmit",
		"check-types:storybook": "tsc -p storybook/tsconfig.json --noEmit",
		"check-types": "pnpm check-types:app && pnpm check-types:tooling && pnpm check-types:storybook",
		"check-imports": "biome lint src",
		"lint": "prettier --check \"**/*.{js,jsx,mjs,mts,ts,tsx,json,yml,yaml}\"",
		"lint:fix": "prettier --write \"**/*.{js,jsx,mjs,mts,ts,tsx,json,yml,yaml}\""
	},
	"dependencies": {
		"@mantine/core": "9.5.0",
		"@mantine/hooks": "9.5.0",
		"history": "5.3.0",
		"mobx": "7.0.0",
		"mobx-react-lite": "5.0.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"universal-router": "10.0.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@storybook/react-vite": "10.5.6",
		"@types/node": "26.1.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"lefthook": "2.1.9",
		"prettier": "3.9.6",
		"storybook": "10.5.6",
		"typescript": "7.0.2",
		"vite": "8.2.0",
		"vite-plugin-checker": "0.14.5"
	}
}
