{
	"name": "frontend",
	"version": "0.0.1",
	"engines": {
		"node": ">=24.16.0",
		"pnpm": ">=11.5.0"
	},
	"engineStrict": true,
	"volta": {
		"node": "24.16.0",
		"pnpm": "11.5.2"
	},
	"scripts": {
		"prepare": "lefthook install",
		"dev": "env-cmd -f .env vite serve --mode development",
		"build:dev": "env-cmd -f .env vite build --mode development",
		"build": "env-cmd -f .env vite build --mode production",
		"check-types": "tsc --noEmit",
		"check-imports": "biome lint src",
		"lint": "prettier --check \"**/*.{js,jsx,ts,tsx,json,yml,yaml}\"",
		"lint:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,yml,yaml}\""
	},
	"dependencies": {
		"history": "5.3.0",
		"mobx": "6.12.3",
		"mobx-react-lite": "4.0.7",
		"react": "18.2.0",
		"react-dom": "18.2.0",
		"universal-router": "10.0.3",
		"vite": "8.0.14",
		"vite-plugin-checker": "0.14.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@types/react": "18.2.74",
		"@types/react-dom": "18.2.23",
		"concurrently": "9.2.4",
		"cross-env": "7.0.3",
		"env-cmd": "10.1.0",
		"lefthook": "2.1.9",
		"prettier": "3.3.3",
		"ts-loader": "9.5.1",
		"typescript": "5.6.3"
	}
}
